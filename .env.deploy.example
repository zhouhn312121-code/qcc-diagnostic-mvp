# Temporary HTTPS hostname, for example: qcc.203-0-113-10.sslip.io
QCC_HOST=

# Shared login. Escape each $ in the Caddy hash as $$ for Docker Compose.
# Never store the plaintext password here.
QCC_AUTH_USER=qcc
QCC_AUTH_PASSWORD_HASH=

# DeepSeek OpenAI-compatible API. Leave AI_API_KEY blank to use the built-in rule engine.
AI_BASE_URL=https://api.deepseek.com
AI_API_KEY=
AI_MODEL=deepseek-v4-flash

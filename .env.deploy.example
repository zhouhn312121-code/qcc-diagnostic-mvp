# Temporary HTTPS hostname, for example: qcc.203-0-113-10.sslip.io
QCC_HOST=
NEXT_PUBLIC_DRAWIO_URL=https://embed.diagrams.net/

# Shared login. Escape each $ in the Caddy hash as $$ for Docker Compose.
# Never store the plaintext password here.
QCC_AUTH_USER=qcc
QCC_AUTH_PASSWORD_HASH=

# DeepSeek OpenAI-compatible API. Leave AI_API_KEY blank to use the built-in rule engine.
AI_BASE_URL=https://api.deepseek.com
AI_API_KEY=
AI_MODEL=deepseek-v4-flash
# Comma-separated models shown in the diagnosis model selector.
AI_MODELS=deepseek-v4-flash,deepseek-v4-pro

# Alibaba Cloud Model Studio vision API (China North 2 / Beijing).
VISION_API_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
VISION_API_KEY=
VISION_MODEL=qwen3.7-plus

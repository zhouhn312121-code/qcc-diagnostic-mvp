# OpenAI-compatible chat completion endpoint. Leave blank to use the built-in QCC rule engine.
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
AI_MODELS=

# Optional database location. Defaults to ./data/qcc.db
DATABASE_PATH=


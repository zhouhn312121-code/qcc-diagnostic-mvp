# OpenAI-compatible chat completion endpoint. Leave blank to use the built-in QCC rule engine.
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
AI_MODELS=

# Alibaba Cloud Model Studio vision API (China North 2 / Beijing).
# Keep the key in .env.local only; never commit a real key.
VISION_API_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
VISION_API_KEY=
VISION_MODEL=qwen3.7-plus

# Optional database location. Defaults to ./data/qcc.db
DATABASE_PATH=

# draw.io Embed Mode address. Use the official editor locally; replace with the internal self-hosted address before production rollout.
NEXT_PUBLIC_DRAWIO_URL=https://embed.diagrams.net/
